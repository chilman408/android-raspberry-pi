+
+void PlaybackThread::openWsSocket() {
+    if (mWsFd >= 0) return;
+
+    mWsFd = socket(AF_UNIX, SOCK_STREAM, 0);
+    if (mWsFd < 0) {
+        ALOGE("openWsSocket: socket() failed: %s", strerror(errno));
+        return;
+    }
+
+    struct sockaddr_un addr = {};
+    addr.sun_family = AF_UNIX;
+    strncpy(addr.sun_path, "/dev/socket/ws_audio", sizeof(addr.sun_path) - 1);
+
+    if (connect(mWsFd, reinterpret_cast<struct sockaddr*>(&addr), sizeof(addr)) < 0) {
+        ALOGW("openWsSocket: connect() failed: %s", strerror(errno));
+        close(mWsFd);
+        mWsFd = -1;
+        return;
+    }
+
+    ALOGI("openWsSocket: connected to /dev/socket/ws_audio (fd=%d)", mWsFd);
+}
+
+static bool writeAll(int fd, const void* buffer, size_t count) {
+    const auto* data = static_cast<const uint8_t*>(buffer);
+    size_t remaining = count;
+    while (remaining > 0) {
+        const ssize_t written = TEMP_FAILURE_RETRY(write(fd, data, remaining));
+        if (written <= 0) {
+            return false;
+        }
+        data += written;
+        remaining -= static_cast<size_t>(written);
+    }
+    return true;
+}
+
+void PlaybackThread::sendToWsServer(const void* data, size_t bytes) {
+    if (bytes == 0) return;
+    if (mWsFd < 0) openWsSocket();
+    if (mWsFd < 0) return;
+
+    const uint32_t length = htonl(static_cast<uint32_t>(bytes));
+    if (!writeAll(mWsFd, &length, sizeof(length)) ||
+            !writeAll(mWsFd, data, bytes)) {
+        ALOGW("sendToWsServer: write failed: %s", strerror(errno));
+        close(mWsFd);
+        mWsFd = -1;
+    }
+}
