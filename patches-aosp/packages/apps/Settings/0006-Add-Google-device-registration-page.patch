+package com.android.settings.deviceinfo.gsf;
+
+import android.content.ContentResolver;
+import android.database.Cursor;
+import android.net.Uri;
+import android.text.TextUtils;
+import android.util.Log;
+
+import androidx.annotation.Nullable;
+
+final class GsfIdReader {
+    static final Uri GSERVICES_URI = Uri.parse("content://com.google.android.gsf.gservices");
+
+    private static final String TAG = "GsfIdReader";
+    private static final String ANDROID_ID_KEY = "android_id";
+    private static final String VALUE_COLUMN = "value";
+
+    private GsfIdReader() {}
+
+    @Nullable
+    static String read(ContentResolver resolver) {
+        try (Cursor cursor = resolver.query(
+                GSERVICES_URI,
+                null,
+                null,
+                new String[] {ANDROID_ID_KEY},
+                null)) {
+            if (cursor == null || !cursor.moveToFirst()) {
+                return null;
+            }
+            int valueColumn = cursor.getColumnIndex(VALUE_COLUMN);
+            if (valueColumn < 0 && cursor.getColumnCount() > 1) {
+                valueColumn = 1;
+            }
+            if (valueColumn < 0) {
+                return null;
+            }
+            final String value = cursor.getString(valueColumn);
+            if (TextUtils.isEmpty(value) || !TextUtils.isDigitsOnly(value)) {
+                return null;
+            }
+            return value;
+        } catch (RuntimeException exception) {
+            Log.w(TAG, "Unable to read GSF Android ID", exception);
+            return null;
+        }
+    }
+}
