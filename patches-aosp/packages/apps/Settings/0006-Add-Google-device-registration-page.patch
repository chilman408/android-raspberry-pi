+package com.android.settings.deviceinfo.gsf;
+
+import android.app.settings.SettingsEnums;
+import android.content.ActivityNotFoundException;
+import android.content.ClipData;
+import android.content.ClipboardManager;
+import android.content.Intent;
+import android.net.Uri;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.widget.Toast;
+
+import androidx.preference.Preference;
+
+import com.android.settings.R;
+import com.android.settings.SettingsPreferenceFragment;
+
+public class GsfRegistrationFragment extends SettingsPreferenceFragment {
+    private static final String KEY_ID = "gsf_android_id";
+    private static final String KEY_REFRESH = "refresh_gsf_android_id";
+    private static final String KEY_COPY = "copy_gsf_android_id";
+    private static final String KEY_OPEN = "open_google_registration";
+    private static final String REGISTRATION_URL =
+            "https://www.google.com/android/uncertified/";
+    private static final long REFRESH_POLL_DELAY_MILLIS = 500;
+    private static final int REFRESH_POLL_ATTEMPTS = 30;
+
+    private Preference mIdPreference;
+    private Preference mCopyPreference;
+    private String mGsfAndroidId;
+    private String mRefreshToken;
+    private int mRefreshAttemptsRemaining;
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+    private final Runnable mRefreshRunnable = this::pollForRefreshedId;
+
+    @Override
+    public int getMetricsCategory() {
+        return SettingsEnums.DEVICEINFO;
+    }
+
+    @Override
+    public void onCreate(Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        addPreferencesFromResource(R.xml.gsf_registration_settings);
+        mIdPreference = findPreference(KEY_ID);
+        mCopyPreference = findPreference(KEY_COPY);
+    }
+
+    @Override
+    public void onResume() {
+        super.onResume();
+        updateGsfAndroidId();
+    }
+
+    @Override
+    public void onPause() {
+        mHandler.removeCallbacks(mRefreshRunnable);
+        super.onPause();
+    }
+
+    @Override
+    public boolean onPreferenceTreeClick(Preference preference) {
+        switch (preference.getKey()) {
+            case KEY_REFRESH:
+                requestGsfAndroidIdRefresh();
+                return true;
+            case KEY_COPY:
+                copyGsfAndroidId();
+                return true;
+            case KEY_OPEN:
+                openRegistrationPage();
+                return true;
+            default:
+                return super.onPreferenceTreeClick(preference);
+        }
+    }
+
+    private void requestGsfAndroidIdRefresh() {
+        mHandler.removeCallbacks(mRefreshRunnable);
+        mRefreshAttemptsRemaining = REFRESH_POLL_ATTEMPTS;
+        showRefreshingState();
+        mRefreshToken = GsfIdReader.requestRefresh();
+        if (mRefreshToken == null) {
+            mRefreshAttemptsRemaining = 0;
+            updateGsfAndroidId();
+            return;
+        }
+        mHandler.postDelayed(mRefreshRunnable, REFRESH_POLL_DELAY_MILLIS);
+    }
+
+    private void pollForRefreshedId() {
+        if (GsfIdReader.isRefreshComplete(mRefreshToken)) {
+            updateGsfAndroidId();
+            return;
+        }
+        if (--mRefreshAttemptsRemaining <= 0) {
+            updateGsfAndroidId();
+            return;
+        }
+        mHandler.postDelayed(mRefreshRunnable, REFRESH_POLL_DELAY_MILLIS);
+    }
+
+    private void showRefreshingState() {
+        mGsfAndroidId = null;
+        mIdPreference.setSummary(R.string.gsf_registration_id_refreshing);
+        mIdPreference.setCopyingEnabled(false);
+        mCopyPreference.setEnabled(false);
+    }
+
+    private void updateGsfAndroidId() {
+        mGsfAndroidId = GsfIdReader.read();
+        final boolean available = mGsfAndroidId != null;
+        mIdPreference.setSummary(available
+                ? mGsfAndroidId : getString(R.string.gsf_registration_id_unavailable));
+        mIdPreference.setCopyingEnabled(available);
+        mCopyPreference.setEnabled(available);
+    }
+
+    private void copyGsfAndroidId() {
+        if (mGsfAndroidId == null) {
+            return;
+        }
+        final ClipboardManager clipboard =
+                requireContext().getSystemService(ClipboardManager.class);
+        if (clipboard == null) {
+            return;
+        }
+        clipboard.setPrimaryClip(ClipData.newPlainText(
+                getString(R.string.gsf_registration_id_title), mGsfAndroidId));
+        Toast.makeText(requireContext(), R.string.gsf_registration_id_copied,
+                Toast.LENGTH_SHORT).show();
+    }
+
+    private void openRegistrationPage() {
+        final Intent intent = new Intent(Intent.ACTION_VIEW, Uri.parse(REGISTRATION_URL));
+        intent.addCategory(Intent.CATEGORY_BROWSABLE);
+        try {
+            startActivity(intent);
+        } catch (ActivityNotFoundException exception) {
+            Toast.makeText(requireContext(), R.string.gsf_registration_no_browser,
+                    Toast.LENGTH_LONG).show();
+        }
+    }
+}
