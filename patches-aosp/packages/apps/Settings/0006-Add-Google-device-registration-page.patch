+package com.android.settings.deviceinfo.gsf;
+
+import static com.google.common.truth.Truth.assertThat;
+
+import org.junit.Test;
+import org.junit.runner.RunWith;
+import org.robolectric.RobolectricTestRunner;
+
+@RunWith(RobolectricTestRunner.class)
+public class GsfIdReaderTest {
+    @Test
+    public void read_decimalId_returnsValue() {
+        final FakePropertyAccess properties = new FakePropertyAccess();
+        properties.mId = "1234567890123456789";
+
+        assertThat(GsfIdReader.read(properties)).isEqualTo("1234567890123456789");
+    }
+
+    @Test
+    public void read_nonDecimalValue_returnsNull() {
+        final FakePropertyAccess properties = new FakePropertyAccess();
+        properties.mId = "not-an-id";
+
+        assertThat(GsfIdReader.read(properties)).isNull();
+    }
+
+    @Test
+    public void read_zeroOrOversizedValue_returnsNull() {
+        final FakePropertyAccess properties = new FakePropertyAccess();
+        properties.mId = "0000000000000000000";
+        assertThat(GsfIdReader.read(properties)).isNull();
+
+        properties.mId = "123456789012345678901";
+        assertThat(GsfIdReader.read(properties)).isNull();
+    }
+
+    @Test
+    public void requestRefresh_writesUniqueToken() {
+        final FakePropertyAccess properties = new FakePropertyAccess();
+
+        assertThat(GsfIdReader.requestRefresh(properties, "123456789")).isTrue();
+        assertThat(properties.mRefreshToken).isEqualTo("123456789");
+    }
+
+    @Test
+    public void isRefreshComplete_requiresMatchingAcknowledgement() {
+        final FakePropertyAccess properties = new FakePropertyAccess();
+        properties.mReadyToken = "123456789";
+
+        assertThat(GsfIdReader.isRefreshComplete(properties, "123456789")).isTrue();
+        assertThat(GsfIdReader.isRefreshComplete(properties, "987654321")).isFalse();
+    }
+
+    @Test
+    public void propertyFailure_isContained() {
+        final GsfIdReader.PropertyAccess properties = new GsfIdReader.PropertyAccess() {
+            @Override
+            public String get(String name) {
+                throw new SecurityException("denied");
+            }
+
+            @Override
+            public void set(String name, String value) {
+                throw new SecurityException("denied");
+            }
+        };
+
+        assertThat(GsfIdReader.read(properties)).isNull();
+        assertThat(GsfIdReader.requestRefresh(properties, "1")).isFalse();
+        assertThat(GsfIdReader.isRefreshComplete(properties, "1")).isFalse();
+    }
+
+    private static final class FakePropertyAccess implements GsfIdReader.PropertyAccess {
+        private String mId = "";
+        private String mReadyToken = "";
+        private String mRefreshToken;
+
+        @Override
+        public String get(String name) {
+            if (GsfIdReader.GSF_ID_PROPERTY.equals(name)) {
+                return mId;
+            }
+            assertThat(name).isEqualTo(GsfIdReader.GSF_ID_READY_PROPERTY);
+            return mReadyToken;
+        }
+
+        @Override
+        public void set(String name, String value) {
+            assertThat(name).isEqualTo(GsfIdReader.GSF_ID_REFRESH_PROPERTY);
+            mRefreshToken = value;
+        }
+    }
+}
