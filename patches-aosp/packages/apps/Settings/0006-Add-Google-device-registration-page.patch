diff --git a/res/values/strings.xml b/res/values/strings.xml
index f92fd2aca8..60c5a671cd 100644
--- a/res/values/strings.xml
+++ b/res/values/strings.xml
@@ -11454,6 +11454,21 @@
     <!-- Title for preference category showing the name of device identifiers. [CHAR LIMIT=60]-->
     <string name="my_device_info_device_identifiers_category_title">Device identifiers</string>
 
+    <!-- Title of the local custom-ROM registration page. [CHAR LIMIT=60] -->
+    <string name="gsf_registration_title">Google Play registration</string>
+    <!-- Summary of the local custom-ROM registration page. [CHAR LIMIT=NONE] -->
+    <string name="gsf_registration_summary">View the GSF Android ID used for Google device registration</string>
+    <!-- Action that opens Google Play services' installation identifier screen. [CHAR LIMIT=40] -->
+    <string name="gsf_registration_show_id">Show GSF Android ID</string>
+    <!-- Error shown if Google Play services cannot display the installation identifier. [CHAR LIMIT=NONE] -->
+    <string name="gsf_registration_id_unavailable">Google Play services ID screen is unavailable</string>
+    <!-- Action that opens Google's custom-ROM registration form. [CHAR LIMIT=50] -->
+    <string name="gsf_registration_open_google">Open Google registration page</string>
+    <!-- Error shown when no browser can open Google's registration form. [CHAR LIMIT=NONE] -->
+    <string name="gsf_registration_no_browser">No browser is available to open the registration page</string>
+    <!-- Instructions shown at the bottom of the custom-ROM registration page. [CHAR LIMIT=NONE] -->
+    <string name="gsf_registration_instructions">Select Show GSF Android ID. Google Play services may first download a small update; let it finish, then record the decimal ID it displays and submit it at Google\'s registration page. Registration is per installation and can take up to 24 hours. After waiting 24 hours, if Google Play Store or YouTube still shows the registration error, open the affected app\'s App info page, select Storage &amp; cache, clear storage, and reopen it. Do not clear Google Play services or Google Services Framework; that can create a new GSF Android ID that must be registered again. A clean flash or factory reset can also create a new ID.</string>
+
     <!-- Title for Wifi Access settings [CHAR LIMIT=35] -->
     <string name="change_wifi_state_title">Wi-Fi control</string>
 
