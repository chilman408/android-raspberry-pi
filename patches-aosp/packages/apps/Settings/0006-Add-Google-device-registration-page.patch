+package com.android.settings.deviceinfo.gsf;
+
+import android.os.SystemClock;
+import android.os.SystemProperties;
+import android.text.TextUtils;
+import android.util.Log;
+
+import androidx.annotation.Nullable;
+
+final class GsfIdReader {
+    static final String GSF_ID_PROPERTY = "sys.tesla_android.gsf_id";
+    static final String GSF_ID_READY_PROPERTY = "sys.tesla_android.gsf_id_ready";
+    static final String GSF_ID_REFRESH_PROPERTY = "sys.tesla_android.gsf_id_refresh";
+
+    private static final String TAG = "GsfIdReader";
+    private static final int MAX_GSF_ID_LENGTH = 20;
+    private static final PropertyAccess SYSTEM_PROPERTIES = new PropertyAccess() {
+        @Override
+        public String get(String name) {
+            return SystemProperties.get(name);
+        }
+
+        @Override
+        public void set(String name, String value) {
+            SystemProperties.set(name, value);
+        }
+    };
+
+    private GsfIdReader() {}
+
+    @Nullable
+    static String read() {
+        return read(SYSTEM_PROPERTIES);
+    }
+
+    @Nullable
+    static String read(PropertyAccess properties) {
+        try {
+            return sanitize(properties.get(GSF_ID_PROPERTY));
+        } catch (RuntimeException exception) {
+            Log.w(TAG, "Unable to read GSF Android ID", exception);
+            return null;
+        }
+    }
+
+    @Nullable
+    static String requestRefresh() {
+        final String token = Long.toString(SystemClock.elapsedRealtimeNanos());
+        return requestRefresh(SYSTEM_PROPERTIES, token) ? token : null;
+    }
+
+    static boolean requestRefresh(PropertyAccess properties, String token) {
+        try {
+            properties.set(GSF_ID_REFRESH_PROPERTY, token);
+            return true;
+        } catch (RuntimeException exception) {
+            Log.w(TAG, "Unable to request a GSF Android ID refresh", exception);
+            return false;
+        }
+    }
+
+    static boolean isRefreshComplete(String token) {
+        return isRefreshComplete(SYSTEM_PROPERTIES, token);
+    }
+
+    static boolean isRefreshComplete(PropertyAccess properties, String token) {
+        try {
+            return token.equals(properties.get(GSF_ID_READY_PROPERTY));
+        } catch (RuntimeException exception) {
+            Log.w(TAG, "Unable to read GSF Android ID refresh status", exception);
+            return false;
+        }
+    }
+
+    @Nullable
+    private static String sanitize(String value) {
+        if (TextUtils.isEmpty(value) || value.length() > MAX_GSF_ID_LENGTH
+                || !TextUtils.isDigitsOnly(value)) {
+            return null;
+        }
+        for (int index = 0; index < value.length(); ++index) {
+            if (value.charAt(index) != '0') {
+                return value;
+            }
+        }
+        return null;
+    }
+
+    interface PropertyAccess {
+        String get(String name);
+        void set(String name, String value);
+    }
+}
