From 91f5ec28f04790b10fbec51c047f311a2d437125 Mon Sep 17 00:00:00 2001
From: Tesla Android CI <ci@teslaandroid.local>
Date: Tue, 8 Sep 2026 23:35:00 -0700
Subject: [PATCH] ih8sn: disable unsafe property spoof on Android 15

The bundled ih8sn binary mutates read-only properties after Android's
property service has created them. On Android 15, ro.build.fingerprint
is stored as a long property. ih8sn replaces its inline compatibility
buffer with the shorter Pixel fingerprint while leaving kLongFlag set.

Every later property reader interprets four bytes of "release-keys" as
the long-value offset and faults. This prevents odrefresh, both zygotes,
update_engine, and system_server from starting.

Keep the prebuilt and configuration packaged for now, but make its init
file inert so a stale installed copy cannot execute during either init
or boot_completed. A future Android-15-compatible implementation can
restore spoofing without mutating an initialized read-only property.

Signed-off-by: Tesla Android CI <ci@teslaandroid.local>
---
 services/ih8sn/etc/init/ih8sn.rc | 12 +++++-------
 1 file changed, 5 insertions(+), 7 deletions(-)

diff --git a/services/ih8sn/etc/init/ih8sn.rc b/services/ih8sn/etc/init/ih8sn.rc
index 7584da3..c11e83a 100644
--- a/services/ih8sn/etc/init/ih8sn.rc
+++ b/services/ih8sn/etc/init/ih8sn.rc
@@ -1,7 +1,5 @@
-on init
-    exec u:r:su:s0 root root -- /system/bin/ih8sn init
-    exec u:r:sysinit:s0 root root -- /system/bin/ih8sn init
-
-on property:sys.boot_completed=1
-    exec u:r:su:s0 root root -- /system/bin/ih8sn boot_completed
-    exec u:r:sysinit:s0 root root -- /system/bin/ih8sn boot_completed
+# ih8sn mutates initialized read-only properties using a legacy layout.
+# On Android 15 this corrupts long ro.* property records and crashes readers.
+# Keep the integration inert until ih8sn can spoof properties without rewriting
+# prop_info storage after property initialization.
+#
