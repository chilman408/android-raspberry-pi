diff --git a/services/lighttpd/www-default/main.dart.js b/services/lighttpd/www-default/main.dart.js
index 7fddc3c..6fe1c22 100644
--- a/services/lighttpd/www-default/main.dart.js
+++ b/services/lighttpd/www-default/main.dart.js
@@ -83546,7 +83546,8 @@ B.Bh=new A.JM()
 B.ls=new A.JY()
 B.Android15Release=new A.P("Android 15 Release","Platform and app compatibility","Tesla Android now runs on Android 15. This release adds the verified Compatibility Store (Aurora) for apps missing from Google Play and includes major display, browser audio, and virtual touchscreen reliability improvements.")
 B.Android15Streaming=new A.P("Streaming Compatibility","Netflix and Disney+ playback fixes","Netflix video playback is restored, and Disney+ adaptive-resolution playback no longer fails when the Raspberry Pi 4 hardware decoder changes stream resolution.\n\nApple TV protected playback remains unvalidated and unsupported on this Widevine L3, unprotected-output device.")
-B.Android15Items=A.a(s([B.Android15Release,B.Android15Streaming]),t.O)
+B.Android15Gsf=new A.P("Google Device Registration","Play Protect registration instructions","Open Settings > About device > Google Play registration. The decimal GSF Android ID is displayed on that page; select Copy GSF Android ID and submit it at https://www.google.com/android/uncertified/. If the ID says Not available yet, connect to the internet, wait for Google Play services to finish setup, then select Refresh GSF Android ID.\n\nWait 24 hours after registration. If Google Play Store or YouTube still shows the registration error, open that affected app's App info page and select Storage & cache > Clear storage, then reopen the app.\n\nDo not clear Google Play services or Google Services Framework. Doing so, or performing a clean flash or factory reset, can create a new GSF Android ID that must be registered again.")
+B.Android15Items=A.a(s([B.Android15Release,B.Android15Streaming,B.Android15Gsf]),t.O)
 B.Android15Version=new A.bx("2026.39.a15.1",B.Android15Items)
 B.CN=new A.P("Frontend Beta","Performance improvements","You can now access the beta Tesla Android frontend app at https://device.teslaandroid.com/beta. The new app uses much less memory and consumes less resources.")
 B.CU=new A.P("Bluetooth Audio","Stability improvements","BT Audio shouldn't interfere with Browser Audio anymore, if you intend to pair your car with the device via BT make sure to disable Browser Audio first.")
