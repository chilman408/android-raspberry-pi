Subject: [PATCH] Document GSF device registration

---
 .../www-default/beta/js/release-notes/release-notes-data.js  | 5 +++++
 services/lighttpd/www-default/flutter_service_worker.js      | 4 ++--
 services/lighttpd/www-default/main.dart.js                   | 3 ++-
 3 files changed, 9 insertions(+), 3 deletions(-)

diff --git a/services/lighttpd/www-default/beta/js/release-notes/release-notes-data.js b/services/lighttpd/www-default/beta/js/release-notes/release-notes-data.js
index 582b46e..fb077e5 100644
--- a/services/lighttpd/www-default/beta/js/release-notes/release-notes-data.js
+++ b/services/lighttpd/www-default/beta/js/release-notes/release-notes-data.js
@@ -17,6 +17,11 @@
           "title": "Streaming Compatibility",
           "shortDescription": "Netflix and Disney+ playback fixes",
           "descriptionMarkdown": "Netflix video playback is restored, and Disney+ adaptive-resolution playback no longer fails when the Raspberry Pi 4 hardware decoder changes stream resolution.\n\nApple TV protected playback remains unvalidated and unsupported on this Widevine L3, unprotected-output device."
+        },
+        {
+          "title": "Google Device Registration",
+          "shortDescription": "Play Protect registration instructions",
+          "descriptionMarkdown": "Open Settings > About device > Google Play registration. The decimal GSF Android ID is displayed on that page; select Copy GSF Android ID and submit it at https://www.google.com/android/uncertified/. If the ID says Not available yet, connect to the internet, wait for Google Play services to finish setup, then select Refresh GSF Android ID.\n\nWait 24 hours after registration. If Google Play Store or YouTube still shows the registration error, open that affected app's App info page and select Storage & cache > Clear storage, then reopen the app.\n\nDo not clear Google Play services or Google Services Framework. Doing so, or performing a clean flash or factory reset, can create a new GSF Android ID that must be registered again."
         }
       ]
     },
diff --git a/services/lighttpd/www-default/flutter_service_worker.js b/services/lighttpd/www-default/flutter_service_worker.js
