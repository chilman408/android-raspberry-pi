From 1f69bd9747b35e66b0618e7356c25a9bb27c0001 Mon Sep 17 00:00:00 2001
From: Hilman <hilman@users.noreply.github.com>
Date: Sun, 30 Aug 2026 16:00:00 -0700
Subject: [PATCH] abootcmd: trace Android partition loading

Add checkpoints around allocation, header probing, smart loading, and the
fallback full-partition read. This distinguishes a reset in the allocator
from one in Android image parsing or MMC block I/O.
---
 cmd/abootimg.c | 17 ++++++++++++++++-
 1 file changed, 16 insertions(+), 1 deletion(-)

diff --git a/cmd/abootimg.c b/cmd/abootimg.c
index 7fe199295f..d1a6000000 100644
--- a/cmd/abootimg.c
+++ b/cmd/abootimg.c
@@ -202,13 +202,20 @@ static int abootimg_smart_load(struct blk_desc *desc, struct disk_partition *in
 		return CMD_RET_FAILURE;
 	}
 
+	printf("ANDROID: Header block read; probing image format...\n");
 	size = android_image_get_valuable_size(addr);
-	if (size == 0)
+	if (size == 0) {
+		printf("ANDROID: Header not recognized; smart load unavailable.\n");
 		return 0;
+	}
 
+	printf("ANDROID: Smart image size is 0x%x bytes; reading payload...\n",
+	       size);
 	ret = blk_dread(desc, info->start, DIV_ROUND_UP(size, info->blksz), addr);
 	if (ret < 0) {
 		printf("Error: Failed to read partition\n");
 		return CMD_RET_FAILURE;
 	}
+	printf("ANDROID: Smart payload read completed.\n");
 
 	memset(addr + size, 0, info->size * info->blksz - size);
 
@@ -329,17 +336,25 @@ static int do_abootimg_load(struct cmd_tbl *cmdtp, int flag, int argc,
 		return CMD_RET_FAILURE;
 	}
 
+	printf("ANDROID: Allocating 0x%lx bytes for '%s'...\n",
+	       (ulong)(info.size * info.blksz), buf);
 	addr = (void *)memalign(4096, info.size * info.blksz);
 	if (!addr) {
 		printf("Error: Failed to allocate memory\n");
 		return CMD_RET_FAILURE;
 	}
+	printf("ANDROID: Allocation for '%s' completed at 0x%p.\n", buf, addr);
 
+	printf("ANDROID: Probing '%s' for smart loading...\n", buf);
 	ret = abootimg_smart_load(desc, &info, addr);
 	if (ret <= 0) {
+		printf("ANDROID: Reading complete '%s' partition (%lu blocks)...\n",
+		       buf, info.size);
 		ret = blk_dread(desc, info.start, info.size, addr);
 		if (ret < 0) {
 			printf("Error: Failed to read partition %s\n", buf);
 			goto fail;
 		}
+		printf("ANDROID: Full read of '%s' completed.\n", buf);
 	}
 
 	sprintf(buf, "abootimg_%s_ptr", argv[3]);
-- 
