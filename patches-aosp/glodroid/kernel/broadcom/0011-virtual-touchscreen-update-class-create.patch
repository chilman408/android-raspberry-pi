From: Hilman <hilman@users.noreply.github.com>
Date: Sat, 29 Aug 2026 10:03:00 -0700
Subject: [PATCH] input: update virtual touchscreen class_create for Linux 6.6

---
 drivers/input/touchscreen/virtual_touchscreen.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/input/touchscreen/virtual_touchscreen.c b/drivers/input/touchscreen/virtual_touchscreen.c
index 553d48c..5555555 100644
--- a/drivers/input/touchscreen/virtual_touchscreen.c
+++ b/drivers/input/touchscreen/virtual_touchscreen.c
@@ -79,7 +79,7 @@ static int __init virt_ts_init(void)
     }
     printk ("virtual_touchscreen: Major=%d\n", Major);
 
-    cl = class_create(THIS_MODULE, DEVICE_NAME);
+    cl = class_create(DEVICE_NAME);
     if (!IS_ERR(cl)) {
 	    dev = device_create(cl, NULL, MKDEV(Major,0), NULL, DEVICE_NAME);
     }
