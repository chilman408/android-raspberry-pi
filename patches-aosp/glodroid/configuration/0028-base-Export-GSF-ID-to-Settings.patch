diff --git a/common/base/gsf-id-exporter.rc b/common/base/gsf-id-exporter.rc
new file mode 100644
index 0000000..0137b98
--- /dev/null
+++ b/common/base/gsf-id-exporter.rc
@@ -0,0 +1,13 @@
+# Export only the decimal GSF Android ID for the local Settings registration page.
+service gsf_id_exporter /system_ext/bin/gsf-id-exporter
+    class late_start
+    user root
+    group root
+    disabled
+    oneshot
+
+on property:sys.boot_completed=1
+    start gsf_id_exporter
+
+on property:sys.tesla_android.gsf_id_refresh=*
+    start gsf_id_exporter
diff --git a/common/base/gsf_id_exporter.cpp b/common/base/gsf_id_exporter.cpp
new file mode 100644
index 0000000..610b152
--- /dev/null
+++ b/common/base/gsf_id_exporter.cpp
@@ -0,0 +1,110 @@
+/*
+ * Copyright 2026 TeslaAndroid-R15-Rpi4
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *      http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#include <android-base/properties.h>
+#include <sqlite3.h>
+#include <unistd.h>
+
+#include <string>
+#include <string_view>
+#include <utility>
+
+namespace {
+
+constexpr char kDatabasePath[] =
+        "/data/user/0/com.google.android.gms/databases/gservices.db";
+constexpr char kIdProperty[] = "sys.tesla_android.gsf_id";
+constexpr char kReadyProperty[] = "sys.tesla_android.gsf_id_ready";
+constexpr char kRefreshProperty[] = "sys.tesla_android.gsf_id_refresh";
+constexpr char kAndroidIdKey[] = "android_id";
+constexpr int kMaxAttempts = 120;
+constexpr unsigned int kRetryDelaySeconds = 5;
+
+bool IsValidGsfId(std::string_view value) {
+    if (value.empty() || value.size() > 20) {
+        return false;
+    }
+
+    bool hasNonZeroDigit = false;
+    for (const char character : value) {
+        if (character < '0' || character > '9') {
+            return false;
+        }
+        hasNonZeroDigit |= character != '0';
+    }
+    return hasNonZeroDigit;
+}
+
+bool ReadGsfId(std::string* value) {
+    sqlite3* database = nullptr;
+    const int openResult = sqlite3_open_v2(
+            kDatabasePath, &database, SQLITE_OPEN_READONLY | SQLITE_OPEN_NOMUTEX, nullptr);
+    if (openResult != SQLITE_OK) {
+        if (database != nullptr) {
+            sqlite3_close(database);
+        }
+        return false;
+    }
+
+    sqlite3_stmt* statement = nullptr;
+    constexpr char kQuery[] =
+            "SELECT value FROM \"main\" WHERE name = ?1 LIMIT 1";
+    bool success = false;
+    if (sqlite3_prepare_v2(database, kQuery, -1, &statement, nullptr) == SQLITE_OK
+            && sqlite3_bind_text(statement, 1, kAndroidIdKey, -1, SQLITE_STATIC) == SQLITE_OK
+            && sqlite3_step(statement) == SQLITE_ROW) {
+        const unsigned char* result = sqlite3_column_text(statement, 0);
+        const int resultSize = sqlite3_column_bytes(statement, 0);
+        if (result != nullptr && resultSize > 0) {
+            std::string candidate(reinterpret_cast<const char*>(result), resultSize);
+            if (IsValidGsfId(candidate)) {
+                *value = std::move(candidate);
+                success = true;
+            }
+        }
+    }
+
+    if (statement != nullptr) {
+        sqlite3_finalize(statement);
+    }
+    sqlite3_close(database);
+    return success;
+}
+
+}  // namespace
+
+int main() {
+    // Never leave a value from a previous Google Play services installation visible.
+    if (!android::base::SetProperty(kIdProperty, "")) {
+        return 2;
+    }
+
+    for (int attempt = 0; attempt < kMaxAttempts; ++attempt) {
+        std::string id;
+        if (ReadGsfId(&id)) {
+            if (!android::base::SetProperty(kIdProperty, id)) {
+                return 2;
+            }
+            const std::string refreshToken =
+                    android::base::GetProperty(kRefreshProperty, "boot");
+            return android::base::SetProperty(kReadyProperty, refreshToken) ? 0 : 2;
+        }
+        if (attempt + 1 < kMaxAttempts) {
+            sleep(kRetryDelaySeconds);
+        }
+    }
+    return 1;
+}
diff --git a/common/base/sepolicy/system_ext/private/file_contexts b/common/base/sepolicy/system_ext/private/file_contexts
new file mode 100644
index 0000000..35fdf9f
--- /dev/null
+++ b/common/base/sepolicy/system_ext/private/file_contexts
@@ -0,0 +1 @@
+/system_ext/bin/gsf-id-exporter    u:object_r:gsf_id_exporter_exec:s0
diff --git a/common/base/sepolicy/system_ext/private/gsf_id_exporter.te b/common/base/sepolicy/system_ext/private/gsf_id_exporter.te
new file mode 100644
index 0000000..36c970a
--- /dev/null
+++ b/common/base/sepolicy/system_ext/private/gsf_id_exporter.te
@@ -0,0 +1,17 @@
+type gsf_id_exporter, domain, coredomain, mlstrustedsubject;
+type gsf_id_exporter_exec, exec_type, system_file_type, file_type;
+
+init_daemon_domain(gsf_id_exporter)
+
+# The executable has no arguments or IPC surface. It reads one hard-coded row from
+# the Google Play services GServices database and exits after publishing the value.
+allow gsf_id_exporter system_data_root_file:dir search;
+allow gsf_id_exporter system_userdir_file:dir search;
+allow gsf_id_exporter system_data_file:dir search;
+allow gsf_id_exporter privapp_data_file:dir r_dir_perms;
+allow gsf_id_exporter privapp_data_file:file r_file_perms;
+
+set_prop(gsf_id_exporter, tesla_gsf_id_prop)
+get_prop(gsf_id_exporter, tesla_gsf_id_refresh_prop)
+
+neverallow { domain -init -gsf_id_exporter } tesla_gsf_id_prop:property_service set;
